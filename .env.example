# Copy to .env (never commit it). Used by docker-compose.yml.

# Database password (letters and digits only, since it goes into a URL).
POSTGRES_PASSWORD=

# Signs cookies; generate with: openssl rand -base64 48
SECRET_KEY_BASE=

# The host name clients use to reach the archive, and how (TLS is terminated in front).
PHX_HOST=localhost
PHX_SCHEME=https
PHX_URL_PORT=443

# Optional relevance judging for find (docs/judging.md). Leave CONTEXT_ARCHIVE_JUDGE
# empty to return unjudged results.
CONTEXT_ARCHIVE_JUDGE=
CONTEXT_ARCHIVE_JUDGE_URL=
CONTEXT_ARCHIVE_JUDGE_MODEL=
CONTEXT_ARCHIVE_JUDGE_API_KEY=
